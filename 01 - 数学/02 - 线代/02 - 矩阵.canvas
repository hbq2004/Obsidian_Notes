		{
			"id":"62fa21b809a44cf3",
			"type":"text",
			"text":"A，B 可以不是方阵",
			"styleAttributes":{"textAlign":"center"},
			"x":7920,
			"y":11802,
			"width":260,
			"height":60
		},
		{
			"id":"1c7084a3949c636a",
			"type":"text",
			"text":"主不变，副对调",
			"styleAttributes":{"textAlign":"center"},
			"x":7980,
			"y":10750,
			"width":260,
			"height":60
		},
		{
			"id":"7abce1709b8be941",
			"type":"text",
			"text":"大转 + 小转",
			"styleAttributes":{"textAlign":"center"},
			"x":7980,
			"y":10947,
			"width":260,
			"height":60
		},
		{"id":"cfbc6c167b22f848","type":"file","file":"_Attachments/Images/Pasted image 20260809165549.png","x":6720,"y":2360,"width":399,"height":133},
		{
			"id":"7625e905d26e9816",
			"type":"text",
			"text":"矩阵的**行(列)成比例**（或者**所有元素都一样**）且为非零矩阵，可以写成**一列 × 一行**的形式，再根据矩阵的秩越乘越小，得到该矩阵的秩一定 $= 1$. ",
			"styleAttributes":{"textAlign":"center"},
			"x":6705,
			"y":1966,
			"width":613,
			"height":153
		},
