		{"id":"6b2aaf6d6af10129","type":"file","file":"_Attachments/Images/Pasted image 20260714053212.png","x":35,"y":1100,"width":399,"height":290},
		{"id":"a2c6390c58e16b82","type":"file","file":"_Attachments/Images/Pasted image 20260714053107.png","x":-1040,"y":1108,"width":472,"height":119},
		{
			"id":"1b6c4fed0011efd4",
			"type":"text",
			"text":"(4) 有理函数积分",
