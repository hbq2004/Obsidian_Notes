		{"id":"41fade2e01ccba89","type":"file","file":"_Attachments/Images/Pasted image 20260714060325.png","x":10100,"y":1080,"width":643,"height":185},
		{
			"id":"7baee9c002e317e1",
			"type":"text",
			"text":"伽马函数\n\n1. [零次方zju](https://www.bilibili.com/video/BV1kuafzPEqy/) \n2. [Kira ](https://www.bilibili.com/video/BV1Nt411Q7wr/) ",
			"styleAttributes":{"textAlign":"center"},
