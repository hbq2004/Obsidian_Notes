		{"id":"aca9fc1dc40a489a","type":"file","file":"_Attachments/Images/Pasted image 20260714083846.png","x":880,"y":1592,"width":400,"height":366},
		{
			"id":"6537ea9545e737f0",
			"type":"text",
			"text":"(1) 定积分几何意义",
			"styleAttributes":{"textAlign":"center"},
			"x":1400,
			"y":1065,
			"width":260,
			"height":60
		},
		{"id":"060ffa6bd77e3309","type":"file","file":"_Attachments/Images/Pasted image 20260714083852.png","x":1592,"y":1605,"width":400,"height":383},
		{"id":"61d52c6735ae7edc","type":"file","file":"_Attachments/Images/Pasted image 20260714062846.png","x":-804,"y":2027,"width":400,"height":186},
		{
			"id":"2b1669e21f3caa5b",
			"type":"text",
			"text":"留数法 + 趋势法（多次因式的低次系数） + 特殊值\n\n1. [零次方zju](https://www.bilibili.com/video/BV1TBRqBsEf5/?vd_source=5e53118bdffba34d123bb97d9a7caf9a) \n2. [郭伟](https://www.bilibili.com/video/BV18K4y1Y7kC/) \n\n",
			"styleAttributes":{"textAlign":"center"},
			"x":-460,
			"y":1605,
			"width":479,
			"height":245
		},
		{
			"id":"ea213f26202fc72d",
			"type":"text",
			"text":"若出现分子是二次的待定系数，\n直接使用带值法（极限法）比较简单",
			"styleAttributes":{"textAlign":"center"},
			"x":96,
			"y":2054,
			"width":380,
			"height":180
		},
		{"id":"494c7cd7589251c8","type":"file","file":"_Attachments/Images/Pasted image 20260714082032.png","x":-404,"y":2046,"width":500,"height":357},
