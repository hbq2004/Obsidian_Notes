			"width":260,
			"height":60
		},
		{
			"id":"a4971457662f097b",
			"type":"text",
			"text":"(2) 换元法（第二类凑微分法）",
			"styleAttributes":{"textAlign":"center"},
			"x":-2960,
			"y":845,
			"width":400,
			"height":100
		},
		{"id":"0f2fb37da8524e63","type":"file","file":"_Attachments/Images/Pasted image 20260714053012.png","x":-3047,"y":1115,"width":574,"height":224},
		{"id":"c13bc3fe6a140026","type":"file","file":"_Attachments/Images/Pasted image 20260716212542.png","x":-2649,"y":1757,"width":499,"height":210},
		{"id":"8d2c758434450d74","type":"file","file":"_Attachments/Images/Pasted image 20260714073700.png","x":-3345,"y":1700,"width":596,"height":269},
		{
			"id":"46d1c8e8ea7a4893",
			"type":"text",
			"text":"(1) 不定积分",
			"styleAttributes":{"textAlign":"center"},
