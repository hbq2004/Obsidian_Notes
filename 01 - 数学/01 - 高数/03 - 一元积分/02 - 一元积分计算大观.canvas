		},
		{"id":"0092f739a692a36b","type":"file","file":"_Attachments/Images/Pasted image 20260714053054.png","x":-1620,"y":1107,"width":499,"height":120},
		{"id":"1a8655024a405e1f","type":"file","file":"_Attachments/Images/Pasted image 20260714052955.png","x":-2190,"y":1065,"width":400,"height":276},
		{
			"id":"4323686ee54a020f",
			"type":"text",
			"text":"(3) 分部积分法",
