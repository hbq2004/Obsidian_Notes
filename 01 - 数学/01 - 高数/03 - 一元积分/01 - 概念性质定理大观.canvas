{
	"nodes":[
		{"id":"986d94d9abb9627b","type":"group","x":-6060,"y":3520,"width":3320,"height":3080,"color":"2","label":"导数极限定理"},
		{"id":"9037624d36523add","type":"group","x":-5760,"y":1040,"width":2720,"height":1760,"color":"1","label":"原函数（不定积分）存在定理"},
		{"id":"a0ac00082c3ba7a1","type":"group","x":1280,"y":1196,"width":2840,"height":1124,"label":"定积分性质"},
		{"id":"eef53230714e0a89","type":"group","x":-2640,"y":1040,"width":1800,"height":1320,"label":"定积分定义"},
		{"id":"6ddb511e3fd9d2f8","type":"group","x":-680,"y":1120,"width":1820,"height":1200,"color":"1","label":"定积分存在定理"},
		{"id":"1b340838ba97fa13","type":"group","x":-7000,"y":1120,"width":800,"height":560,"label":"不定积分定义"},
		{
			"id":"df8c8b59aa6d9a87",
			"type":"text",
			"text":"原函数极限存在 $\\not\\implies$ 极限值等于函数值\n\n函数**点**连续，且导函数极限存在 $\\implies$ **导函数极限值**等于**导函数函数值**\n\n![[Pasted image 20260712223328.png]]",
			"styleAttributes":{"textAlign":"center"},
			"x":-4540,
			"y":3656,
			"width":720,
			"height":551
		},
		{"id":"b2d67dde1c109dee","type":"file","file":"_Attachments/Images/Pasted image 20260712194156.png","x":-6940,"y":1172,"width":672,"height":271},
		{
			"id":"f740f9b4f33b2004",
			"type":"text",
			"text":"不定积分一定要**指明在某个区间上**",
			"styleAttributes":{"textAlign":"center"},
			"x":-6784,
			"y":1529,
			"width":360,
			"height":100
		},
		{"id":"da90bbdc4f0fa68d","type":"file","file":"_Attachments/Images/result_k9nrl6.png","x":-5721,"y":2131,"width":449,"height":401},
		{
			"id":"4a9feb3a44b238b9",
			"type":"text",
			"text":"(1) 不定积分",
			"styleAttributes":{"textAlign":"center"},
			"x":-5540,
			"y":500,
			"width":260,
			"height":60
		},
		{"id":"51160c0cbd0e4736","type":"file","file":"_Attachments/Images/Pasted image 20260712200115.png","x":-1745,"y":1209,"width":624,"height":340},
